# Drizzle
DATABASE_URL="file:local.db"
# Only needed for a libsql server that requires auth
DATABASE_AUTH_TOKEN=""

# OpenRouter Config
OPENROUTER_API_KEY=""
# Model the chat assistant runs on; defaults to openai/gpt-5.6-luna
# OPENROUTER_MODEL="openai/gpt-5.6-luna"

# Auth
# Shared household password required to sign in
APP_PASSWORD=""
# Secret used to sign session cookies — keep stable across restarts
SESSION_SECRET=""

# Alexa
# Skill ID of the private Alexa skill (see alexa/README.md); leave unset to turn /api/alexa off
# ALEXA_SKILL_ID="amzn1.ask.skill.00000000-0000-0000-0000-000000000000"
